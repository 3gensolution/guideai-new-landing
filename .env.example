# 3Guide SDK — copy to .env.local and fill in.
# Publishable values: inlined into the client bundle and visible in-browser.
# The SDK authorises by origin, so a leaked pk_live_ key can't be used from
# another domain. Secret keys must never live in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_GUIDEAI_SITE_ID=
NEXT_PUBLIC_GUIDEAI_TOKEN=
NEXT_PUBLIC_GUIDEAI_CDN_URL=https://cdn.3guideai.com
